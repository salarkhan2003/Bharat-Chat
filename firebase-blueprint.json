{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "publicKey": { "type": "string", "description": "Public key for Signal Protocol E2EE" },
        "privacySettings": {
          "type": "object",
          "properties": {
            "showLastSeen": { "type": "boolean" },
            "showReadReceipts": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "displayName"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "content": { "type": "string", "description": "Encrypted content" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "type": { "type": "string", "enum": ["text", "image", "file"] },
        "iv": { "type": "string" },
        "senderPublicKey": { "type": "string" }
      },
      "required": ["senderId", "content", "createdAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Real-time presence and typing status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "isTyping": { "type": "boolean" },
        "currentChatId": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": "User",
      "description": "User's individual contact list"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a conversation"
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "Real-time user status"
    },
    "/ai_chats/{userId}": {
      "schema": {
        "title": "AIChat",
        "description": "History of conversations with Bharat AI",
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["user", "model"] },
                "content": { "type": "string" }
              }
            }
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Bharat AI conversation history per user"
    }
  }
}
